# .env (in the root of your project: my_rag_project/.env)

# Database
POSTGRES_DB=db
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_HOST=db # 'db' is the service name in docker compose for the DB
POSTGRES_PORT=5432

# Ollama
OLLAMA_BASE_URL=http://ollama:11434 # 'ollama' is the service name in docker-compose for Ollama
OLLAMA_MODEL_NAME=llama3 # Or mistral, gemma, etc.

# auth
SECRET_KEY="your_secret_key_here"